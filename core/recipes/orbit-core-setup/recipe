# Orbit Core first boot: no password ships in the image. On the first start Orbit creates the
# password database and asks on the console for a root password, before anyone can log in.
name=orbit-core-setup
version=3
stage=base
sources=()
sha256=()
depends=(base-files systemd shadow)
description="Orbit Core first-boot setup (root password, hostname, wired network)"

build() {
  install -d "$DESTDIR/usr/lib/orbit-core" "$DESTDIR/usr/lib/systemd/system/sysinit.target.wants" "$DESTDIR/etc"
  echo orbit > "$DESTDIR/etc/hostname"
  cat > "$DESTDIR/usr/lib/orbit-core/first-boot" <<'SH'
#!/bin/bash
# Runs once, on the console, before the login prompt (orbit-first-boot.service).
set -u
[ -f /etc/shadow ] || pwconv
[ -f /etc/gshadow ] || grpconv
# root has no usable password until its shadow entry holds a real hash ($…); pwconv leaves "x"
if ! awk -F: '$1 == "root" && $2 ~ /^\$/ {found = 1} END {exit !found}' /etc/shadow; then
  echo
  echo "Welcome to Orbit OS Core. Choose a password for the administrator (root)."
  until passwd root; do echo "Try again."; done
fi
touch /var/lib/orbit-core-first-boot.done
SH
  chmod 755 "$DESTDIR/usr/lib/orbit-core/first-boot"
  cat > "$DESTDIR/usr/lib/systemd/system/orbit-first-boot.service" <<'UNIT'
[Unit]
Description=Orbit Core first-boot setup (root password)
ConditionPathExists=!/var/lib/orbit-core-first-boot.done
After=systemd-remount-fs.service systemd-vconsole-setup.service
Before=getty@tty1.service serial-getty@ttyS0.service systemd-user-sessions.service
DefaultDependencies=no
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/orbit-core/first-boot
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/console
TTYReset=yes
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
UNIT
  ln -sf ../orbit-first-boot.service "$DESTDIR/usr/lib/systemd/system/sysinit.target.wants/orbit-first-boot.service"

  # wired network out of the box: systemd-networkd with DHCP (IPv4 and IPv6), systemd-resolved for
  # DNS, systemd-timesyncd for the clock. Wi-Fi comes with iwd later.
  install -d "$DESTDIR/usr/lib/systemd/network" "$DESTDIR/usr/lib/systemd/system/multi-user.target.wants" \
    "$DESTDIR/usr/lib/systemd/system/sysinit.target.wants" "$DESTDIR/usr/lib/systemd/system/sockets.target.wants"
  cat > "$DESTDIR/usr/lib/systemd/network/80-orbit-wired.network" <<'NET'
[Match]
Type=ether
Kind=!*

[Network]
DHCP=yes
MulticastDNS=yes

[DHCPv4]
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100
NET
  for u in systemd-networkd.service systemd-resolved.service; do
    ln -sf ../$u "$DESTDIR/usr/lib/systemd/system/multi-user.target.wants/$u"
  done
  ln -sf ../systemd-networkd.socket "$DESTDIR/usr/lib/systemd/system/sockets.target.wants/systemd-networkd.socket"
  ln -sf ../systemd-timesyncd.service "$DESTDIR/usr/lib/systemd/system/sysinit.target.wants/systemd-timesyncd.service"
  ln -sf ../run/systemd/resolve/stub-resolv.conf "$DESTDIR/etc/resolv.conf"
}
