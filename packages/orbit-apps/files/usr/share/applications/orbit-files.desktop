[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse, organise and find your files
Exec=orbit-files %U
Icon=orbit-files
Categories=GTK;System;FileTools;FileManager;Core;
StartupNotify=true
DBusActivatable=false
MimeType=inode/directory;
Keywords=folder;explorer;manager;spaces;trash;
Actions=new-window;
StartupWMClass=org.orbit_os.Files

[Desktop Action new-window]
Name=New Window
Exec=orbit-files
