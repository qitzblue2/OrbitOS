# GNU Bourne-Again shell: the final Orbit build (replaces the temporary one).
name=bash
version=5.3
stage=base
sources=(https://ftp.gnu.org/gnu/bash/bash-5.3.tar.gz)
sha256=(0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba)
depends=(base-files readline ncurses)
replaces=(bash-temp)
description="GNU Bourne-Again shell"

build() {
  ./configure --prefix=/usr --without-bash-malloc --with-installed-readline --docdir=/usr/share/doc/bash
  make
  make DESTDIR="$DESTDIR" install
  ln -sf bash "$DESTDIR/usr/bin/sh"
}
