#!/usr/bin/python3 -I
"""Orbit safety snapshots (root). Called by apt before updates and by orbit-updater-helper.

  orbit-snapshot pre-update     take a "before update" snapshot when it makes sense
  orbit-snapshot list           JSON list of snapshots
  orbit-snapshot undo           put the newest "before update" snapshot back (restarts the PC)
  orbit-snapshot on|off         turn the automatic snapshots on or off

Never fails an update: pre-update always exits 0 and says why it skipped.
"""
import json
import os
import shutil
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/orbit-os/python")
from orbit import snapshots  # noqa: E402

ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"}
STAMP = "/var/lib/orbit/last-snapshot"


def root_device():
    r = subprocess.run(["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True, env=ENV)
    return r.stdout.strip().split("[")[0]


def timeshift(*args, **kw):
    return subprocess.run(["timeshift", *args, "--snapshot-device", root_device(), "--rsync", "--scripted"],
                          env=ENV, **kw)


def listing():
    if not shutil.which("timeshift"):
        return []
    r = timeshift("--list", capture_output=True, text=True, timeout=120)
    return snapshots.parse_list(r.stdout)


def pre_update():
    if not shutil.which("timeshift"):
        return "timeshift not installed"
    live = os.path.exists("/run/live") or "boot=live" in open("/proc/cmdline").read()
    chroot = subprocess.run(["systemd-detect-virt", "--chroot"], env=ENV).returncode == 0
    try:
        last = float(open(STAMP).read())
    except (OSError, ValueError):
        last = 0
    st = os.statvfs("/")
    ok, why = snapshots.should_snapshot(snapshots.load_conf().get("enabled", True), st.f_bavail * st.f_frsize,
                                        last, time.time(), live, chroot)
    if not ok:
        return why
    print("Orbit: taking a safety snapshot before the update (Orbit Updater can undo it)…", flush=True)
    r = timeshift("--create", "--comments", snapshots.COMMENT, "--tags", "O", "--quiet",
                  stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, timeout=3600)
    if r.returncode:
        return "snapshot failed: " + (r.stderr.strip().splitlines() or ["?"])[-1]
    os.makedirs(os.path.dirname(STAMP), exist_ok=True)
    with open(STAMP, "w") as f:
        f.write(str(time.time()))
    for name in snapshots.to_delete(listing()):
        timeshift("--delete", "--snapshot", name, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return "snapshot taken"


def main(argv):
    if os.geteuid() != 0:
        sys.exit("must run as root")
    cmd = argv[1:]
    if cmd == ["pre-update"]:
        try:
            print("Orbit snapshot:", pre_update(), flush=True)
        except Exception as e:  # noqa: BLE001 - never block an update
            print("Orbit snapshot skipped:", e, flush=True)
        sys.exit(0)
    if cmd == ["list"]:
        print(json.dumps(listing()))
        sys.exit(0)
    if cmd in (["on"], ["off"]):
        os.makedirs(os.path.dirname(snapshots.CONF), exist_ok=True)
        with open(snapshots.CONF, "w") as f:
            json.dump({"enabled": cmd == ["on"]}, f)
        sys.exit(0)
    if cmd == ["undo"]:
        mine = [s for s in listing() if s["orbit"]]
        if not mine:
            sys.exit("there is no snapshot from before an update")
        dev = root_device()
        r = timeshift("--restore", "--snapshot", mine[-1]["name"], "--target-device", dev, "--skip-grub", "--yes")
        sys.exit(r.returncode)
    sys.exit("usage: orbit-snapshot pre-update|list|undo|on|off")


if __name__ == "__main__":
    main(sys.argv)
