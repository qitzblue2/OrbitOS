# GNU awk, cross-compiled with the Orbit toolchain into the new tree.
# Temporary: replaced by the final build inside Orbit in the system stage.
name=gawk-temp
version=5.4.1
stage=temp
sources=(https://ftp.gnu.org/gnu/gawk/gawk-5.4.1.tar.xz)
sha256=(07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37)
depends=(libstdcxx)
description="GNU awk (temporary)"

build() {
  sed -i 's/extras//' Makefile.in
  ./configure --prefix=/usr --host="$TGT" --build="$(build-aux/config.guess)"
  make
  make DESTDIR="$DESTDIR$ORBIT" install
}
