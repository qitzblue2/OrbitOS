# For running the server from source: copy to .env in the project folder.
# The desktop app doesn't use this file: paste your key under AI configuration instead
# (it is saved to %APPDATA%\ORBIT\.env on Windows). Keys are never sent to the dashboard.
ORBIT_PORT=7777
ORBIT_HOST=127.0.0.1
# AI provider: anthropic | offline
ORBIT_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ORBIT_FAST_MODEL=claude-haiku-5-5
ORBIT_REASONING_MODEL=claude-opus-5-5
# Dashboard login token (generated on first run if empty)
ORBIT_ADMIN_TOKEN=
# Optional smart home
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HUE_BRIDGE_IP=
HUE_USERNAME=
