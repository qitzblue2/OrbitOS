# Cross binutils (assembler, linker) for x86_64-orbit-linux-gnu, built with the host compiler.
name=binutils-pass1
version=2.47
stage=cross
sources=(https://ftp.gnu.org/gnu/binutils/binutils-2.47.tar.xz)
sha256=(154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff)
depends=(filesystem)
description="GNU binutils, cross build for the Orbit toolchain"

build() {
  mkdir -v build && cd build
  ../configure --prefix="$ORBIT/tools" --with-sysroot="$ORBIT" --target="$TGT" \
    --disable-nls --enable-gprofng=no --disable-werror --enable-new-dtags --enable-default-hash-style=gnu
  make
  make DESTDIR="$DESTDIR" install
}
