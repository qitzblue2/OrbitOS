# GNU Readline: line editing for shells and interpreters.
name=readline
version=8.3
stage=base
sources=(https://ftp.gnu.org/gnu/readline/readline-8.3.tar.gz)
sha256=(fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc)
depends=(base-files)
description="GNU Readline line-editing library"

build() {
  # no .old copies, no rpath in the shared libraries
  sed -i '/MV.*old/d' Makefile.in
  sed -i '/{OLDSUFF}/c:' support/shlib-install
  sed -i 's/-Wl,-rpath,[^ ]*//' support/shobj-conf
  ./configure --prefix=/usr --disable-static --with-curses --docdir=/usr/share/doc/readline-8.3
  make SHLIB_LIBS="-lncursesw"
  make SHLIB_LIBS="-lncursesw" DESTDIR="$DESTDIR" install
}
