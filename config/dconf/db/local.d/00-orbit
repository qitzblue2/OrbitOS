# Orbit OS defaults. Users can change all of these; nothing is locked.
[org/gnome/desktop/interface]
gtk-theme='Orbit-graphite'
icon-theme='orbit'
color-scheme='prefer-dark'
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='JetBrains Mono 11'
enable-hot-corners=false
accent-color='slate'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/orbit/orbit-light.png'
picture-uri-dark='file:///usr/share/backgrounds/orbit/orbit-glass.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/orbit/orbit-graphite.png'

[org/gnome/desktop/privacy]
report-technical-problems=false
send-software-usage-stats=false
remember-recent-files=true

[org/gnome/desktop/sound]
event-sounds=false

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx', 'orbit-launcher@orbit-os', 'orbit-control-center@orbit-os', 'orbit-widgets@orbit-os', 'orbit-clipboard@orbit-os', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'gsconnect@andyholmes.github.io']
favorite-apps=['orbit-files.desktop', 'aphelion.desktop', 'orbit-notes.desktop', 'org.gnome.Terminal.desktop', 'orbit-store.desktop', 'org.keepassxc.KeePassXC.desktop', 'orbit-settings.desktop']
welcome-dialog-last-shown-version='999'

[org/gnome/shell/extensions/user-theme]
name='Orbit-graphite'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='LEFT'
extend-height=true
dock-fixed=true
dash-max-icon-size=36
show-trash=false
show-mounts=false
custom-theme-shrink=true
transparency-mode='FIXED'
background-opacity=0.0
running-indicator-style='DOTS'

[org/gnome/shell/extensions/blur-my-shell]
sigma=14
brightness=0.85

[org/gnome/shell/extensions/blur-my-shell/popup]
# Keep Orbit's colors on menus: without this, Blur my Shell restyles Quick Settings toggles
# GNOME-blue with !important (found with tests/shell/run-desktop-shots.sh)
preserve-shell-theme=true

[org/gnome/mutter]
experimental-features=['scale-monitor-framebuffer']

[org/gnome/shell/keybindings]
# Super+V is Orbit Clipboard; the notification list keeps GNOME's other key, Super+M
toggle-message-tray=['<Super>m']

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-screenshot/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-files/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-space-1/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-space-2/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-space-3/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-task-manager/']
home=@as []
# Windows habit: Super+I opens Settings
control-center=['<Super>i']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-screenshot]
name='Orbit Screenshot (area)'
command='orbit-screenshot --capture'
binding='<Shift><Super>s'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-files]
name='Orbit Files'
command='orbit-files'
binding='<Super>e'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-space-1]
name='Switch to Space 1'
command='orbit-spaces 1'
binding='<Super><Alt>1'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-space-2]
name='Switch to Space 2'
command='orbit-spaces 2'
binding='<Super><Alt>2'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-space-3]
name='Switch to Space 3'
command='orbit-spaces 3'
binding='<Super><Alt>3'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/orbit-task-manager]
name='Task Manager (Orbit Performance)'
command='orbit-performance'
binding='<Control><Shift>Escape'

[org/gnome/desktop/wm/keybindings]
switch-input-source=['<Super><Alt>space']
# Windows habits: Super+D shows the desktop, Alt+Tab switches windows (not whole apps)
show-desktop=['<Super>d']
switch-windows=['<Alt>Tab']
switch-windows-backward=['<Shift><Alt>Tab']
switch-applications=['<Super>Tab']
switch-applications-backward=['<Shift><Super>Tab']
switch-input-source-backward=@as []

[org/gnome/desktop/wm/preferences]
# minimize and maximize buttons next to close, as on Windows
button-layout='appmenu:minimize,maximize,close'

[org/gnome/terminal/legacy/profiles:]
default='b1dcc9dd-5262-4d8d-a863-c897e6d979b9'
list=['b1dcc9dd-5262-4d8d-a863-c897e6d979b9']

[org/orbit-os/desktop]
style='glass'
reduce-transparency=false
inbox-sorter=false
