[Unit]
Description=ORBIT on the screen (full-screen kiosk)
After=orbit.service systemd-user-sessions.service seatd.service
Wants=orbit.service
Conflicts=getty@tty1.service

[Service]
User=orbitui
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -s -- /usr/local/bin/orbit-kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target multi-user.target
