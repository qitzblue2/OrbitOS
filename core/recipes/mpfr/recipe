# MPFR: multiple-precision floating point (GCC needs it).
name=mpfr
version=4.2.2
stage=base
sources=(https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.2.tar.xz)
sha256=(b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01)
depends=(base-files gmp)
description="multiple-precision floating-point library"

build() {
  ./configure --prefix=/usr --disable-static --enable-thread-safe --docdir=/usr/share/doc/mpfr-4.2.2
  make
  make DESTDIR="$DESTDIR" install
}
