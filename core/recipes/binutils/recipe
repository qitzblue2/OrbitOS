# GNU Binutils (assembler, linker, …): the final Orbit build (replaces pass 2).
name=binutils
version=2.47
stage=base
sources=(https://ftp.gnu.org/gnu/binutils/binutils-2.47.tar.xz)
sha256=(154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff)
depends=(base-files zlib zstd)
replaces=(binutils-pass2)
description="GNU assembler, linker and binary tools"

build() {
  mkdir -v build && cd build
  ../configure --prefix=/usr --sysconfdir=/etc --enable-ld=default --enable-plugins --enable-shared \
    --disable-werror --enable-64-bit-bfd --enable-new-dtags --with-system-zlib --enable-default-hash-style=gnu
  make tooldir=/usr
  make tooldir=/usr DESTDIR="$DESTDIR" install
  rm -f "$DESTDIR"/usr/lib/lib{bfd,ctf,ctf-nobfd,gprofng,opcodes,sframe}.a
}
