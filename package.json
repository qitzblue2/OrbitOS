{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "description": "ORBIT: a voice-first personal AI operating system (server, dashboard and Companion device agent).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "app": "electron .",
    "models": "node app/models.js",
    "companion": "node companion/agent.js",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.12.0",
    "ws": "8.18.0"
  },
  "main": "app/main.js",
  "productName": "ORBIT",
  "author": "ORBIT",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.orbit.desktop",
    "productName": "ORBIT",
    "directories": {
      "output": "release",
      "app": "."
    },
    "files": [
      "app/**",
      "server/**",
      "web/**",
      "companion/**",
      "package.json",
      "!**/*.test.js",
      "app/package.json"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*",
          "!**/test_wavs/**",
          "!**/*epoch-99-avg-1.onnx",
          "!**/*chunk-16-left-64.onnx"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/icons/icon@1024.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "app/icons/icon@1024.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ORBIT listens for \"Hey Orbit\" on this Mac. Wake word and speech recognition run on-device."
      },
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "app/icons/icon@1024.png",
      "category": "Utility"
    }
  }
}
