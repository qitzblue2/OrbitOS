# Orbit OS defaults. Your own choices in ~/.config/mimeapps.list always win.
[Default Applications]
inode/directory=orbit-files.desktop;org.gnome.Nautilus.desktop;
text/markdown=orbit-notes.desktop;org.gnome.TextEditor.desktop;
text/html=aphelion.desktop;firefox-esr.desktop;
application/xhtml+xml=aphelion.desktop;firefox-esr.desktop;
x-scheme-handler/http=aphelion.desktop;firefox-esr.desktop;
x-scheme-handler/https=aphelion.desktop;firefox-esr.desktop;
x-scheme-handler/about=aphelion.desktop;
application/x-ms-dos-executable=orbit-windows.desktop;
application/x-msdownload=orbit-windows.desktop;
application/vnd.microsoft.portable-executable=orbit-windows.desktop;
application/x-msi=orbit-windows.desktop;
application/x-ms-shortcut=orbit-windows.desktop;
application/x-bat=orbit-windows.desktop;
