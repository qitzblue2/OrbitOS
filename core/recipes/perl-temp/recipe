# Perl. Built inside the new Orbit tree with the temporary tools; replaced by the final build later.
name=perl-temp
version=5.44.0
stage=system
sources=(https://www.cpan.org/src/5.0/perl-5.44.0.tar.xz)
sha256=(505cf43912e9480495c344c70260452e32aa2a73c546a026b3f100053b23ce91)
depends=(base-files)
description="Perl (temporary, built in Orbit)"

build() {
  local lib=/usr/lib/perl5/5.44
  sh Configure -des -D prefix=/usr -D vendorprefix=/usr -D useshrplib \
    -D privlib=$lib/core_perl -D archlib=$lib/core_perl -D sitelib=$lib/site_perl -D sitearch=$lib/site_perl \
    -D vendorlib=$lib/vendor_perl -D vendorarch=$lib/vendor_perl
  make
  make DESTDIR="$DESTDIR" install
}
