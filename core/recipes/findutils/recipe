# GNU find, xargs and locate: the final Orbit build (replaces the temporary one).
name=findutils
version=4.11.0
stage=base
sources=(https://ftp.gnu.org/gnu/findutils/findutils-4.11.0.tar.xz)
sha256=(bfd19cb06cc71f3352d567e90284d8cdac02ac89774bbeadf0b533b0c11432fd)
depends=(base-files)
replaces=(findutils-temp)
description="GNU find, xargs and locate"

build() {
  ./configure --prefix=/usr --localstatedir=/var/lib/locate
  make
  make DESTDIR="$DESTDIR" install
}
