description="GNU find, xargs (temporary)"

build() {
  ./configure --prefix=/usr --localstatedir=/var/lib/locate --host="$TGT" --build="$(build-aux/config.guess)"
  make
  make DESTDIR="$DESTDIR$ORBIT" install
}
