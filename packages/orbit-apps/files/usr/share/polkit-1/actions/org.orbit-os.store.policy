<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Orbit OS</vendor>
  <action id="org.orbit-os.store.helper">
    <description>Install or remove apps from the Orbit Store</description>
    <message>Authentication is required to install or remove software</message>
    <icon_name>orbit-store</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/orbit-os/orbit-store-helper</annotate>
  </action>
</policyconfig>
