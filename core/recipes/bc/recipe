# bc: an arbitrary-precision calculator (Gavin Howard's, as in Linux From Scratch).
name=bc
version=7.0.3
stage=base
sources=(https://github.com/gavinhoward/bc/releases/download/7.0.3/bc-7.0.3.tar.xz)
sha256=(91eb74caed0ee6655b669711a4f350c25579778694df248e28363318e03c7fc4)
depends=(base-files readline)
description="arbitrary-precision calculator"

build() {
  # bc 7.0.3 pastes true/false into identifiers, which C23 (GCC 15's default) makes keywords
  CC=gcc CFLAGS="-O3 -std=gnu17" ./configure --prefix=/usr -G -O3 -r
  make
  make DESTDIR="$DESTDIR" install
}
