# GNU Bison parser generator. Built inside the new Orbit tree with the temporary tools; replaced by the final build later.
name=bison-temp
version=3.8.2
stage=system
sources=(https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.xz)
sha256=(9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2)
depends=(base-files)
description="GNU Bison parser generator (temporary, built in Orbit)"

build() {
  ./configure --prefix=/usr --docdir=/usr/share/doc/bison-3.8.2
  make
  make DESTDIR="$DESTDIR" install
}
