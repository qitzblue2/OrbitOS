# pkgconf: tells builds where libraries are (also installed as pkg-config).
name=pkgconf
version=2.5.1
stage=base
sources=(https://distfiles.ariadne.space/pkgconf/pkgconf-2.5.1.tar.xz)
sha256=(cd05c9589b9f86ecf044c10a2269822bc9eb001eced2582cfffd658b0a50c243)
depends=(base-files)
description="pkgconf (pkg-config) library build helper"

build() {
  ./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/pkgconf-2.5.1
  make
  make DESTDIR="$DESTDIR" install
  ln -sf pkgconf "$DESTDIR/usr/bin/pkg-config"
}
