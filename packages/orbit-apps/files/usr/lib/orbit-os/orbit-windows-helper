#!/usr/bin/python3 -I
"""Privileged half of Orbit Windows Apps, run through pkexec.

  orbit-windows-helper setup

Turns on Debian's 32-bit packages and installs Wine for 64- and 32-bit
Windows programs, its fonts and winetricks. One fixed job.
"""
import os
import subprocess
import sys

ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "DEBIAN_FRONTEND": "noninteractive", "LANG": "C.UTF-8"}
PACKAGES = ["wine", "wine64", "wine32:i386", "libwine:i386", "fonts-wine", "winetricks"]


def run(cmd):
    print("orbit-windows-helper:", " ".join(cmd), flush=True)
    return subprocess.run(cmd, env=ENV).returncode


def main(argv):
    if os.geteuid() != 0:
        sys.exit("must run as root (via pkexec)")
    if argv[1:] != ["setup"]:
        sys.exit("usage: orbit-windows-helper setup")
    if run(["dpkg", "--add-architecture", "i386"]) or run(["apt-get", "update", "-q"]):
        sys.exit("could not reach the package servers")
    sys.exit(1 if run(["apt-get", "install", "-y", "-q", "--", *PACKAGES]) else 0)


if __name__ == "__main__":
    main(sys.argv)
