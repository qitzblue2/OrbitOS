# GNU gettext message tools. Built inside the new Orbit tree with the temporary tools; replaced by the final build later.
name=gettext-temp
version=0.26
stage=system
sources=(https://ftp.gnu.org/gnu/gettext/gettext-0.26.tar.xz)
sha256=(d1fb86e260cfe7da6031f94d2e44c0da55903dbae0a2fa0fae78c91ae1b56f00)
depends=(base-files)
description="GNU gettext message tools (temporary, built in Orbit)"

build() {
  # only the three programs other builds need now
  # glibc 2.44 makes wmemchr & co. C23 _Generic macros; gnulib redeclares them, so
  # parenthesise the names to keep the macros from expanding in those declarations
  find . -name wchar.in.h -exec sed -i -E \
    's/^(_GL_EXTERN_C wchar_t \*)(wmemchr|wcschr|wcsrchr|wcspbrk|wcsstr) \(/\1(\2) (/' {} +
  ./configure --disable-shared
  make
  mkdir -p "$DESTDIR/usr/bin"
  cp gettext-tools/src/{msgfmt,msgmerge,xgettext} "$DESTDIR/usr/bin"
}
