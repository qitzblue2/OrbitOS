# util-linux system utilities: the final Orbit build (replaces the temporary one).
name=util-linux
version=2.41.6
stage=base
sources=(https://cdn.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-2.41.6.tar.xz)
sha256=(e596083744e746be7d2823b62b43f4418dd7bf56303b4dc09e6fe8112fe3d7ed)
depends=(base-files ncurses zlib libcap)
replaces=(util-linux-temp)
description="util-linux system utilities"

build() {
  mkdir -p "$DESTDIR/var/lib/hwclock"
  # login, su and friends come from shadow
  ./configure --bindir=/usr/bin --libdir=/usr/lib --runstatedir=/run --sbindir=/usr/sbin \
    --disable-chfn-chsh --disable-login --disable-nologin --disable-su --disable-setpriv --disable-runuser \
    --disable-pylibmount --disable-liblastlog2 --disable-static --without-python --without-systemd \
    --without-systemdsystemunitdir ADJTIME_PATH=/var/lib/hwclock/adjtime --docdir=/usr/share/doc/util-linux-2.41.6
  make
  make DESTDIR="$DESTDIR" install
}
